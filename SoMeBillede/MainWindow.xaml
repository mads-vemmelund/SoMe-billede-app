<Window x:Class="SoMeBillede.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SoMe Billede" Height="900" Width="1460" MinHeight="720" MinWidth="1120"
        Background="#E9EEEA" Foreground="#202522" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#244B3A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#326149" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F5F7F4" />
            <Setter Property="Foreground" Value="#244B3A" />
            <Setter Property="BorderBrush" Value="#D5DDD7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF0EB" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="21" />
        </Style>
        <Style x:Key="UploadSurfaceButton" TargetType="Button">
            <Setter Property="Background" Value="#18251E" />
            <Setter Property="BorderBrush" Value="#3B5144" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="UploadSurfaceBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UploadSurfaceBorder" Property="Background" Value="#203329" />
                                <Setter TargetName="UploadSurfaceBorder" Property="BorderBrush" Value="#86A28E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UploadSurfaceBorder" Property="Background" Value="#294635" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="BorderBrush" Value="#D5DDD7" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="BorderBrush" Value="#D5DDD7" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FBFCFA" BorderBrush="#D9E0DA" BorderThickness="0,0,0,1">
            <DockPanel Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" Background="#244B3A" CornerRadius="10">
                        <TextBlock Text="S" Foreground="#DCE9DF" FontSize="23" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SoMe Billede" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="DIT BILLEDE. ALLE FORMATER." FontSize="9" Foreground="#78817B" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="SourceNameText" Text="Intet billede valgt" Foreground="#66736A"
                               VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                    <Button Content="＋   Vælg billede" Style="{StaticResource PrimaryButton}"
                            Click="ChooseImageButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#FBFCFA" BorderBrush="#D9E0DA" BorderThickness="1"
                    CornerRadius="10" Padding="20" Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Formater" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Vælg én eller flere størrelser" Foreground="#78817B"
                                   FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FormatGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                                   Foreground="#244B3A" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Formats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                              Padding="5,8" Cursor="Hand" Background="Transparent">
                                                        <Grid Width="248">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Dimensions}"
                                                                       Foreground="#78817B" FontSize="11"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border DockPanel.Dock="Bottom" Background="#EEF3EF" CornerRadius="7" Padding="11"
                            Margin="0,10,0,0">
                        <TextBlock Text="Billederne behandles lokalt på din computer." FontSize="11"
                                   Foreground="#59645D" TextWrapping="Wrap" />
                    </Border>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,0,4,14">
                    <StackPanel>
                        <TextBlock Text="Arbejdsområde" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock x:Name="ImageDimensionsText" Text="Vælg et billede for at begynde"
                                   Foreground="#78817B" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RotateLeftButton" Content="↶" Style="{StaticResource IconButton}"
                                ToolTip="Rotér mod uret" IsEnabled="False" Click="RotateLeftButton_Click"
                                Margin="0,0,6,0" />
                        <Button x:Name="RotateRightButton" Content="↷" Style="{StaticResource IconButton}"
                                ToolTip="Rotér med uret" IsEnabled="False" Click="RotateRightButton_Click"
                                Margin="0,0,12,0" />
                        <ComboBox x:Name="PreviewFormatBox" Width="245" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" DisplayMemberPath="DisplayName"
                                  SelectionChanged="PreviewFormatBox_SelectionChanged" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="#142019" BorderBrush="#D2DAD4" BorderThickness="1"
                        CornerRadius="10" Padding="12">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                        <Button x:Name="EmptyPreviewButton" Style="{StaticResource UploadSurfaceButton}"
                                Click="ChooseImageButton_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                <Border Width="68" Height="68" Background="#2B4636" CornerRadius="20"
                                        HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <TextBlock Text="＋" FontSize="34" Foreground="#DCE9DF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Start med at vælge et billede" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#F4F7F4" HorizontalAlignment="Center" />
                                <TextBlock Text="Klik hvor som helst her for at gennemse dine filer"
                                           FontSize="13" Foreground="#A8B8AD" HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                                <Border Background="#314B3B" CornerRadius="5" Padding="12,7"
                                        HorizontalAlignment="Center" Margin="0,22,0,0">
                                    <TextBlock Text="Vælg et billede" FontSize="12" FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#203329"
                                CornerRadius="5" Padding="10,6" Margin="0,0,8,8">
                            <TextBlock x:Name="PreviewSizeText" Text="" Foreground="#E7EFE9" FontSize="11" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Margin="4,16,4,0">
                    <TextBlock Text="Tilpasning" FontWeight="SemiBold" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="FitRadio" Content="Bevar hele billedet" IsChecked="True"
                                     GroupName="FitMode" Checked="Adaptation_Checked" Margin="0,0,20,0" />
                        <RadioButton x:Name="FillRadio" Content="Udfyld med beskæring"
                                     GroupName="FitMode" Checked="Adaptation_Checked" />
                    </StackPanel>
                </StackPanel>
            </Grid>
                <Border Grid.Column="2" Background="#FBFCFA" BorderBrush="#D9E0DA" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Eksport" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Gør dine formater klar til download" Foreground="#78817B"
                                   FontSize="12" Margin="0,5,0,20" TextWrapping="Wrap" />
                        <TextBlock Text="FILTYPE" FontSize="10" FontWeight="Bold" Foreground="#78817B" />
                        <ComboBox x:Name="OutputFormatBox" SelectedIndex="0" Margin="0,6,0,16">
                            <ComboBoxItem Content="JPEG" Tag="Jpeg" />
                            <ComboBoxItem Content="PNG" Tag="Png" />
                        </ComboBox>
                        <TextBlock Text="TOM BAGGRUND" FontSize="10" FontWeight="Bold" Foreground="#78817B" />
                        <ComboBox x:Name="BackgroundBox" SelectedIndex="0" Margin="0,6,0,16"
                                  SelectionChanged="BackgroundBox_SelectionChanged">
                            <ComboBoxItem Content="Hvid" Tag="White" />
                            <ComboBoxItem Content="Sort" Tag="Black" />
                            <ComboBoxItem Content="Gennemsigtig" Tag="Transparent" />
                        </ComboBox>
                        <TextBlock Text="FILNAVNSPRÆFIKS" FontSize="10" FontWeight="Bold" Foreground="#78817B" />
                        <TextBox x:Name="FilePrefixBox" Margin="0,6,0,16" ToolTip="Tilføjes foran platformens navn" />
                        <Button Content="Vælg destinationsmappe" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch" Click="ChooseFolderButton_Click" />
                        <TextBlock x:Name="DestinationText" Text="Vælg en mappe ved eksport"
                                   Foreground="#78817B" FontSize="11" Margin="0,7,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <Button x:Name="ExportButton" Content="Eksportér billeder" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch" Click="ExportButton_Click" />
                        <Button x:Name="OpenFolderButton" Content="Åbn destinationsmappe"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"
                                Margin="0,8,0,0" Visibility="Collapsed" Click="OpenFolderButton_Click" />
                        <TextBlock x:Name="StatusText" Text="Klar" Foreground="#78817B" FontSize="11"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
