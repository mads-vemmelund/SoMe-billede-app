<Window x:Class="SoMeBillede.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SoMe Billede" Height="850" Width="1360" MinHeight="700" MinWidth="1050"
        Background="#F0F2EF" Foreground="#202522" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#244B3A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F5F7F4" />
            <Setter Property="Foreground" Value="#244B3A" />
            <Setter Property="BorderBrush" Value="#D5DDD7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="BorderBrush" Value="#D5DDD7" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="BorderBrush" Value="#D5DDD7" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE2DE" BorderThickness="0,0,0,1">
            <DockPanel Margin="28,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#244B3A" CornerRadius="8">
                        <TextBlock Text="S" Foreground="White" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SoMe Billede" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="BILLEDEFORMATER" FontSize="10" Foreground="#78817B" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="SourceNameText" Text="Intet billede valgt" Foreground="#78817B"
                               VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                    <Button Content="＋  Vælg billede" Style="{StaticResource PrimaryButton}"
                            Click="ChooseImageButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="286" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE2DE" BorderThickness="1"
                    CornerRadius="7" Padding="18" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Vælg formater" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Vælg de størrelser, du vil eksportere" Foreground="#78817B"
                                   FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FormatGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                                   Foreground="#244B3A" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Formats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                              Padding="3,7" Cursor="Hand">
                                                        <Grid Width="238">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Dimensions}"
                                                                       Foreground="#78817B" FontSize="11"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border DockPanel.Dock="Bottom" Background="#F5F7F4" CornerRadius="5" Padding="10"
                            Margin="0,10,0,0">
                        <TextBlock Text="Billederne behandles lokalt på din computer." FontSize="11"
                                   Foreground="#59645D" TextWrapping="Wrap" />
                    </Border>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,2,4,12">
                    <StackPanel>
                        <TextBlock Text="Forhåndsvisning" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ImageDimensionsText" Text="Vælg et billede for at begynde"
                                   Foreground="#78817B" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <ComboBox x:Name="PreviewFormatBox" Width="220" HorizontalAlignment="Right"
                              VerticalAlignment="Center" DisplayMemberPath="DisplayName"
                              SelectionChanged="PreviewFormatBox_SelectionChanged" />
                </DockPanel>
                <Border Grid.Row="1" Background="#202522" BorderBrush="#DDE2DE" BorderThickness="1"
                        CornerRadius="7" Padding="18">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                        <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="64" Height="64" Background="#303833" CornerRadius="32"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="＋" FontSize="29" Foreground="#B5C1B8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Start med at vælge et billede" FontSize="16" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Text="Din valgte størrelse vises her" FontSize="12"
                                       Foreground="#B5C1B8" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#303833"
                                CornerRadius="4" Padding="9,5" Margin="0,0,0,4">
                            <TextBlock x:Name="PreviewSizeText" Text="" Foreground="White" FontSize="11" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Margin="4,14,4,0">
                    <TextBlock Text="Billedtilpasning" FontWeight="SemiBold" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="FitRadio" Content="Bevar hele billedet" IsChecked="True"
                                     GroupName="FitMode" Checked="Adaptation_Checked" Margin="0,0,20,0" />
                        <RadioButton x:Name="FillRadio" Content="Udfyld med beskæring"
                                     GroupName="FitMode" Checked="Adaptation_Checked" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Border Grid.Column="2" Background="White" BorderBrush="#DDE2DE" BorderThickness="1"
                    CornerRadius="7" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Eksport" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Gem valgte formater som separate filer" Foreground="#78817B"
                                   FontSize="12" Margin="0,4,0,20" TextWrapping="Wrap" />
                        <TextBlock Text="FILFORMAT" FontSize="10" FontWeight="Bold" Foreground="#78817B" />
                        <ComboBox x:Name="OutputFormatBox" SelectedIndex="0" Margin="0,6,0,16">
                            <ComboBoxItem Content="JPEG" Tag="Jpeg" />
                            <ComboBoxItem Content="PNG" Tag="Png" />
                        </ComboBox>
                        <TextBlock Text="TOM BAGGRUND" FontSize="10" FontWeight="Bold" Foreground="#78817B" />
                        <ComboBox x:Name="BackgroundBox" SelectedIndex="0" Margin="0,6,0,16"
                                  SelectionChanged="BackgroundBox_SelectionChanged">
                            <ComboBoxItem Content="Hvid" Tag="White" />
                            <ComboBoxItem Content="Sort" Tag="Black" />
                            <ComboBoxItem Content="Gennemsigtig" Tag="Transparent" />
                        </ComboBox>
                        <TextBlock Text="FILNAVNSPRÆFIKS" FontSize="10" FontWeight="Bold" Foreground="#78817B" />
                        <TextBox x:Name="FilePrefixBox" Margin="0,6,0,16" ToolTip="Tilføjes foran platformens navn" />
                        <Button Content="Vælg destinationsmappe" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch" Click="ChooseFolderButton_Click" />
                        <TextBlock x:Name="DestinationText" Text="Vælg en mappe ved eksport"
                                   Foreground="#78817B" FontSize="11" Margin="0,7,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <Button x:Name="ExportButton" Content="Eksportér billeder" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch" Click="ExportButton_Click" />
                        <Button x:Name="OpenFolderButton" Content="Åbn destinationsmappe"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"
                                Margin="0,8,0,0" Visibility="Collapsed" Click="OpenFolderButton_Click" />
                        <TextBlock x:Name="StatusText" Text="Klar" Foreground="#78817B" FontSize="11"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
